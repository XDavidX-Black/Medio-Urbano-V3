rules_version='2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Catálogos: lectura pública, escritura solo admin ───
    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /promociones/{promoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /menus/{menuId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ─── Configuración: lectura pública, escritura solo admin ───
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Pedidos: creación anónima, lectura completa solo admin ───
    match /pedidos/{pedidoId} {
      allow read: if true;
      allow create: if true;
      allow list, update, delete: if request.auth != null;
    }

    // ─── Logs: solo admin ───
    match /logs/{logId} {
      allow read, write: if request.auth != null;
    }
  }
}
